{
  "name": "codex-session-manager",
  "version": "1.0.1",
  "description": "Browse and resume local Codex sessions on Windows and macOS",
  "main": "src/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:ui": "electron tests/ui-smoke.js",
    "build:win": "electron-builder --win nsis portable",
    "build:mac": "electron-builder --mac dmg zip --universal"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.codex.sessionmanager",
    "productName": "Codex Session Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools"
    }
  }
}
